{
  "expo": {
    "name": "Huddle",
    "slug": "huddle",
    "scheme": "huddle",
    "version": "0.1.0",
    "android": {
      "package": "org.efren.huddle"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {
        "origin": "https://huddle.efren.org"
      },
      "eas": {
        "projectId": "efec7c92-072c-4b52-be58-3b45a2244a44"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "expo-router",
      "expo-status-bar"
    ]
  }
}
